---
import Layout from "../layouts/Layout.astro"
import type { PriceRow } from "../db/queries.js"
import { readFileSync } from "node:fs"
import { join } from "node:path"
import crypto from "crypto"
import CategoryNode from "../components/CategoryNode.astro"
import type { CategoryGroup } from "../components/CategoryNode.astro"


// Astro/Vite loads .env into import.meta.env
process.env.TURSO_DATABASE_URL ??= import.meta.env.TURSO_DATABASE_URL
process.env.TURSO_AUTH_TOKEN ??= import.meta.env.TURSO_AUTH_TOKEN

// Config loader
interface ProductConfig {
  groupId: string
  name?: string
  urls: string[]
  asins: string[]
  categoryPath: string
  thresholdPercentage?: number
  image?: string
}

const getUrlId = (url: string): string => {
  const filterMatch = url.match(/item_id(?:%3A|=)(MLA\d+)/i)
  if (filterMatch) return filterMatch[1].toUpperCase()

  const upMatch = url.match(/\/up\/(MLAU?\d+)/i)
  if (upMatch) return upMatch[1].toUpperCase()

  const pMatch = url.match(/\/p\/(MLAU?\d+)/i)
  if (pMatch) return pMatch[1].toUpperCase()

  const m = url.match(/(MLA-?\d+)/i)
  if (m) return m[1].replace("-", "").toUpperCase()

  const hash = crypto.createHash("md5").update(url).digest("hex").substring(0, 10).toUpperCase()
  return `MLI${hash}`
}

const loadProductsFromConfig = (filePath: string): ProductConfig[] => {
  try {
    const fileContent = readFileSync(filePath, "utf-8")
    const data = JSON.parse(fileContent)
    const products: ProductConfig[] = []

    const traverse = (val: any, path: string[]) => {
      if (!val || typeof val !== "object") return

      if (typeof val.url === "string") {
        const id = getUrlId(val.url)
        products.push({
          groupId: id,
          name: val.name,
          urls: [val.url],
          asins: [id],
          categoryPath: path.join(" > "),
          thresholdPercentage: val.threshold_percentage,
          image: val.image || undefined,
        })
        return
      }

      if (Array.isArray(val.urls) && val.urls.every((u: any) => typeof u === "string")) {
        const asins = val.urls.map((u: string) => getUrlId(u))
        const groupId = `group_${crypto.createHash("md5").update(val.name || asins[0]).digest("hex").substring(0, 10).toUpperCase()}`
        products.push({
          groupId,
          name: val.name,
          urls: val.urls,
          asins,
          categoryPath: path.join(" > "),
          thresholdPercentage: val.threshold_percentage,
          image: val.image || undefined,
        })
        return
      }

      if (Array.isArray(val)) {
        for (const item of val) {
          traverse(item, path)
        }
        return
      }

      for (const [key, value] of Object.entries(val)) {
        traverse(value, [...path, key])
      }
    }

    traverse(data, [])
    return products
  } catch (e) {
    return []
  }
}

const configPath = join(process.cwd(), "products.json")
const configProducts = loadProductsFromConfig(configPath)

type ProductSummary = {
  asin: string
  title: string | null
  url: string | null
  imageUrl: string | null
  currency: string | null
  latestPrice: number | null
  previousPrice: number | null
  minPrice: number
  maxPrice: number
  availability: string | null
  rating: number | null
  reviewsCount: number | null
  snapshots: number
  lastSeen: string
  categoryPath: string
  customName: string | null
  historyPoints: { price: number; scrapedAt: string }[]
  hasDiscountDay: boolean
  hasDiscountWeek: boolean
  hasDiscountMonth: boolean
  thresholdPercentage: number | null
}

let allPoints: PriceRow[] = []
let products: ProductSummary[] = []
let chartError: string | null = null

const getGroupHistory = (asins: string[], allPointsForGroup: PriceRow[]) => {
  const sortedPoints = [...allPointsForGroup].sort(
    (a, b) => new Date(a.scrapedAt).getTime() - new Date(b.scrapedAt).getTime()
  )
  const latestPrices = new Map<string, number>()
  const aggregatedHistory: { price: number; scrapedAt: string }[] = []

  for (const pt of sortedPoints) {
    if (pt.price !== null) {
      latestPrices.set(pt.asin, pt.price)
    }
    const currentPrices = Array.from(latestPrices.values())
    if (currentPrices.length > 0) {
      const minPrice = Math.min(...currentPrices)
      aggregatedHistory.push({
        price: minPrice,
        scrapedAt: pt.scrapedAt,
      })
    }
  }
  return aggregatedHistory
}

const getPriceDeltaForDuration = (historyPoints: { price: number; scrapedAt: string }[], durationMs: number) => {
  if (historyPoints.length < 2) return null
  const latestPrice = historyPoints.at(-1)!.price
  if (latestPrice === null) return null
  const latestTime = new Date(historyPoints.at(-1)!.scrapedAt).getTime()
  const targetTime = latestTime - durationMs

  let refPoint = historyPoints[0]
  for (const pt of historyPoints) {
    const ptTime = new Date(pt.scrapedAt).getTime()
    if (ptTime <= targetTime) {
      refPoint = pt
    } else {
      break
    }
  }

  if (refPoint.price !== null && refPoint.price !== 0) {
    const diff = latestPrice - refPoint.price
    if (diff < 0) {
      return ((refPoint.price - latestPrice) / refPoint.price) * 100
    }
  }
  return null
}

try {
  const { getAllSnapshots } = await import("../db/queries.js")
  allPoints = await getAllSnapshots()

  const groupedByAsin = new Map<string, PriceRow[]>()
  for (const point of allPoints) {
    const list = groupedByAsin.get(point.asin) ?? []
    list.push(point)
    groupedByAsin.set(point.asin, list)
  }

  const coveredAsins = new Set<string>()
  for (const config of configProducts) {
    for (const asin of config.asins) {
      coveredAsins.add(asin)
    }
  }

  // Build products for configured groups
  const configuredProducts = configProducts.map((config) => {
    const groupPoints = allPoints.filter(p => config.asins.includes(p.asin))
    if (groupPoints.length === 0) return null

    // Get aggregated history (minimum price over time)
    const historyPoints = getGroupHistory(config.asins, groupPoints)

    // Get latest snapshot for each ASIN in the group to compute current state
    const latestSnapshots = config.asins.map(asin => {
      const pts = groupedByAsin.get(asin)
      return pts ? pts.at(-1) : null
    }).filter((s): s is PriceRow => s !== null)

    const cheapestSnapshot = latestSnapshots
      .filter(s => s.price !== null)
      .sort((a, b) => a.price! - b.price!)[0] || latestSnapshots[0]

    const latestPrice = historyPoints.length > 0 ? historyPoints.at(-1)!.price : null
    const previousPrice = historyPoints.length > 1 ? historyPoints.at(-2)!.price : null

    const prices = historyPoints.map(h => h.price)

    let imageUrl = cheapestSnapshot?.imageUrl || null
    if (config.image) {
      if (config.image.startsWith("http://") || config.image.startsWith("https://")) {
        imageUrl = config.image
      } else {
        const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")
        imageUrl = `${baseUrl}/products/${config.image}`
      }
    }

    const hasStock = latestSnapshots.some(s => s.availability === "En stock")
    const maxScrapedAt = new Date(Math.max(...latestSnapshots.map(s => new Date(s.scrapedAt).getTime()))).toISOString()

    const dDay = getPriceDeltaForDuration(historyPoints, 24 * 60 * 60 * 1000)
    const dWeek = getPriceDeltaForDuration(historyPoints, 7 * 24 * 60 * 60 * 1000)
    const dMonth = getPriceDeltaForDuration(historyPoints, 30 * 24 * 60 * 60 * 1000)

    const hasDiscountDay = dDay !== null && dDay > 0
    const hasDiscountWeek = dWeek !== null && dWeek > 0
    const hasDiscountMonth = dMonth !== null && dMonth > 0

    return {
      asin: config.groupId,
      title: config.name || cheapestSnapshot?.title || "Producto",
      url: cheapestSnapshot?.url || config.urls[0],
      imageUrl,
      currency: cheapestSnapshot?.currency || "ARS",
      latestPrice,
      previousPrice,
      minPrice: Math.min(...prices),
      maxPrice: Math.max(...prices),
      availability: hasStock ? "En stock" : "Sin stock",
      rating: cheapestSnapshot?.rating || null,
      reviewsCount: cheapestSnapshot?.reviewsCount || null,
      snapshots: groupPoints.length,
      lastSeen: maxScrapedAt,
      categoryPath: config.categoryPath || "Otros",
      customName: config.name || null,
      historyPoints,
      hasDiscountDay,
      hasDiscountWeek,
      hasDiscountMonth,
      thresholdPercentage: config.thresholdPercentage ?? null
    }
  }).filter((p): p is ProductSummary => p !== null)

  products = configuredProducts
} catch (error) {
  chartError = error instanceof Error ? error.message : "Error de conexión"
}

// Build recursive Category Tree (Hierarchical)
interface CategoryTreeBuilder {
  name: string
  subcategories: Map<string, CategoryTreeBuilder>
  products: ProductSummary[]
}

const rootBuilder: CategoryTreeBuilder = {
  name: "Root",
  subcategories: new Map(),
  products: []
}

for (const prod of products) {
  const parts = prod.categoryPath.split(" > ")
  let current = rootBuilder
  for (const part of parts) {
    if (!current.subcategories.has(part)) {
      current.subcategories.set(part, {
        name: part,
        subcategories: new Map(),
        products: []
      })
    }
    current = current.subcategories.get(part)!
  }
  current.products.push(prod)
}

const convertToGroup = (name: string, builderNode: CategoryTreeBuilder): CategoryGroup => {
  const subcategories = Array.from(builderNode.subcategories.entries())
    .map(([subName, subNode]) => convertToGroup(subName, subNode))

  const products = [...builderNode.products]
  const totalCount = products.length + subcategories.reduce((acc, sub) => acc + sub.totalCount, 0)

  return {
    name,
    subcategories,
    products,
    totalCount
  }
}

const topLevelCategories: CategoryGroup[] = Array.from(rootBuilder.subcategories.entries())
  .map(([name, subNode]) => convertToGroup(name, subNode))

// --- Chart data ---
const trackedAsins = products.map((p) => p.asin)

// Sleek color palette for lines
const palette = ["#FFF159", "#3b82f6", "#10b981", "#ec4899", "#8b5cf6", "#f97316", "#06b6d4", "#84cc16"]
const colorMap = new Map(trackedAsins.map((asin, i) => [asin, palette[i % palette.length]]))

// Collect all aggregated group prices and dates
const allGroupPrices = products.flatMap(p => p.historyPoints.map(pt => pt.price))
const minPrice = allGroupPrices.length > 0 ? Math.min(...allGroupPrices) : 0
const maxPrice = allGroupPrices.length > 0 ? Math.max(...allGroupPrices) : 0
const margin = (maxPrice - minPrice) * 0.1 || 1
const yMin = minPrice - margin
const yMax = maxPrice + margin

const allGroupDates = products.flatMap(p => p.historyPoints.map(pt => new Date(pt.scrapedAt).getTime()))
const minDate = allGroupDates.length > 0 ? Math.min(...allGroupDates) : 0
const maxDate = allGroupDates.length > 0 ? Math.max(...allGroupDates) : 0

const W = 900
const H = 340
const PL = 72
const PR = 20
const PT = 20
const PB = 44
const PW = W - PL - PR
const PH = H - PT - PB

const x = (ts: number) => maxDate === minDate ? PL + PW / 2 : PL + ((ts - minDate) / (maxDate - minDate)) * PW
const y = (p: number) => yMax === yMin ? PT + PH / 2 : PT + ((yMax - p) / (yMax - yMin)) * PH

const yTicks = Array.from({ length: 5 }, (_, i) => yMax - (i / 4) * (yMax - yMin))

const uniqueDays = [...new Set(products.flatMap(p => p.historyPoints.map(pt => pt.scrapedAt.slice(0, 10))))]
const xTickCount = Math.min(6, uniqueDays.length)
const xStep = allGroupDates.length > 1 ? (maxDate - minDate) / Math.max(xTickCount - 1, 1) : 0
const xTicks = Array.from({ length: xTickCount }, (_, i) => {
  const ts = minDate + i * xStep
  return { x: x(ts), label: new Date(ts).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short" }) }
})

const series = products.map((prod) => {
  const pts = prod.historyPoints
  const d = pts
    .map((p, i) => `${i === 0 ? "M" : "L"}${x(new Date(p.scrapedAt).getTime()).toFixed(1)} ${y(p.price).toFixed(1)}`)
    .join(" ")
  return { asin: prod.asin, pts, d, color: colorMap.get(prod.asin)! }
})

// Formatting helper
const fmt = (price: number | null, currency: string | null = "ARS") => {
  if (price === null) return "—"
  const formatted = price.toLocaleString("es-AR", {
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  })
  const symbol = currency === "ARS" || currency === "$" ? "$" : (currency || "$")
  return `${symbol} ${formatted}`
}

const fmtDate = (s: string) => new Date(s).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })
const delta = (a: number | null, b: number | null) =>
  a != null && b != null && b !== 0 ? ((a - b) / b) * 100 : null

const discountsTodayCount = products.filter(p => p.hasDiscountDay).length
const discountsWeekCount = products.filter(p => p.hasDiscountWeek).length
const discountsMonthCount = products.filter(p => p.hasDiscountMonth).length

const maxLastSeen = products.length > 0
  ? new Date(Math.max(...products.map(p => new Date(p.lastSeen).getTime()))).toISOString()
  : new Date().toISOString()
---

<Layout title="Meli Price Tracker | Monitoreo de Precios">
  <main class="page">
    <!-- Next Update Banner -->
    <div class="next-update-banner animate-fade-in" data-last-seen={maxLastSeen}>
      <div class="banner-left">
        <span class="pulse-dot"></span>
        <span class="banner-title">Próxima actualización estimada:</span>
        <span class="banner-time" id="next-update-time">Calculando...</span>
      </div>
      <div class="banner-right">
        <div class="slider-wrapper">
          <span class="slider-label">Intervalo de escaneo: <strong id="slider-value">7 horas</strong></span>
          <div class="slider-control">
            <input type="range" id="update-interval-slider" min="1" max="24" value="7" class="interval-slider" />
          </div>
        </div>
        <div class="cron-box" id="cron-box" title="Copiar expresión cron para GitHub Actions">
          <span class="cron-label">Cron:</span>
          <code id="cron-code">0 */7 * * *</code>
          <button class="copy-btn" id="copy-cron-btn" aria-label="Copiar cron">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="copy-icon"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
      </div>
    </div>

    <header class="top">
      <div class="brand">
        <div class="logo-box">
          <span class="logo-text">Meli</span>
          <span class="logo-badge">Price Tracker</span>
        </div>
        <p class="tagline">Seguimiento inteligente de precios de MercadoLibre en tiempo real</p>
      </div>

      {products.length > 0 && (
        <div class="stats-bar animate-fade-in">
          <div class="stat-card">
            <span class="stat-num">{products.length}</span>
            <span class="stat-lbl">Productos</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">{allPoints.length}</span>
            <span class="stat-lbl">Registros</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">{uniqueDays.length}</span>
            <span class="stat-lbl">Días</span>
          </div>
          <button class="stat-card interactive filter-btn-day" id="filter-btn-day" title="Filtrar por ofertas del último día" data-count={discountsTodayCount}>
            <span class="stat-num">{discountsTodayCount}</span>
            <span class="stat-lbl">Rebajas Hoy</span>
          </button>
          <button class="stat-card interactive filter-btn-week" id="filter-btn-week" title="Filtrar por ofertas de la última semana" data-count={discountsWeekCount}>
            <span class="stat-num">{discountsWeekCount}</span>
            <span class="stat-lbl">Rebajas Semana</span>
          </button>
          <button class="stat-card interactive filter-btn-month" id="filter-btn-month" title="Filtrar por ofertas del último mes" data-count={discountsMonthCount}>
            <span class="stat-num">{discountsMonthCount}</span>
            <span class="stat-lbl">Rebajas Mes</span>
          </button>
        </div>
      )}
    </header>

    {products.length > 0 && (
      <div class="toolbar animate-fade-in">
        <div class="search-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="search-input" placeholder="Buscar por producto, marca o ID..." />
        </div>
        <div class="sort-box">
          <span class="sort-label">Ordenar por:</span>
          <select id="sort-select" class="sort-dropdown">
            <option value="default">Por Defecto</option>
            <option value="discount-desc">Mayor Descuento</option>
            <option value="price-asc">Precio: Menor a Mayor</option>
            <option value="price-desc">Precio: Mayor a Menor</option>
            <option value="date-desc">Última Actualización</option>
          </select>
        </div>
      </div>
    )}

    {chartError ? (
      <div class="notice">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-warning"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{chartError}</span>
      </div>
    ) : (
      <>
        {products.length === 0 ? (
          <div class="notice empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-box"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <h3>No se encontraron registros de precios</h3>
            <p>Ejecutá <code>npm run track</code> para realizar el primer rastreo de productos.</p>
          </div>
        ) : (
          <>
            <div class="categories-grid">
              {topLevelCategories.map((cat) => {
                const isLarge = cat.totalCount > 4 || cat.subcategories.length > 0;
                return (
                  <div class={isLarge ? "category-wrapper span-2" : "category-wrapper"}>
                    <CategoryNode category={cat} level={0} colorMap={colorMap} />
                  </div>
                );
              })}
            </div>

            <section class="chart-section animate-slide-up">
              <div class="chart-header-row">
                <div class="chart-header-left">
                  <h2>Evolución histórica de precios</h2>
                  <p class="subtitle">Gráfico interactivo de precios de productos monitoreados</p>
                </div>

                <div class="chart-controls">
                  <div class="chart-range-selector">
                    <button class="range-btn active" data-range="all">Todo</button>
                    <button class="range-btn" data-range="30">30 días</button>
                    <button class="range-btn" data-range="7">7 días</button>
                  </div>
                </div>

                <div class="legend">
                  {series.map((s) => {
                    const item = products.find(p => p.asin === s.asin)
                    return (
                      <span class="legend-item" title={item?.title || ""}>
                        <span class="dot" style={`background:${s.color}; box-shadow: 0 0 6px ${s.color}`} />
                        {item?.customName || s.asin}
                      </span>
                    )
                  })}
                </div>
              </div>

              <div class="chart" id="chart-container" data-series={JSON.stringify(products.map(p => ({
                asin: p.asin,
                title: p.title,
                customName: p.customName,
                historyPoints: p.historyPoints,
                color: colorMap.get(p.asin),
                currency: p.currency
              })))}>
                <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Historial de precios de MercadoLibre">
                  {yTicks.map((v) => (
                    <g>
                      <line x1={PL} y1={y(v)} x2={W - PR} y2={y(v)} class="grid" />
                      <text x={PL - 10} y={y(v) + 4} class="label" text-anchor="end">{fmt(v, "ARS")}</text>
                    </g>
                  ))}

                  {xTicks.map((t) => (
                    <text x={t.x} y={H - PB + 22} class="label" text-anchor="middle">{t.label}</text>
                  ))}

                  {series.map((s) => (
                    <path d={s.d} fill="none" stroke={s.color} stroke-width="2.5" stroke-linejoin="round" class="chart-line" />
                  ))}

                  {series.map((s) =>
                    s.pts.map((pt) => (
                      <circle
                        cx={x(new Date(pt.scrapedAt).getTime())}
                        cy={y(pt.price)}
                        r="4.5"
                        fill={s.color}
                        class="point"
                        data-price={fmt(pt.price, pt.currency)}
                        data-date={new Date(pt.scrapedAt).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short", hour: "2-digit" }) + "hs"}
                        data-name={products.find(p => p.asin === s.asin)?.title || s.asin}
                        data-color={s.color}
                      />
                    ))
                  )}
                </svg>
                <div class="tooltip" id="chart-tooltip"></div>
              </div>
            </section>
          </>
        )}
      </>
    )}
  </main>

  <div class="modal" id="price-history-modal">
    <div class="modal-overlay"></div>
    <div class="modal-container">
      <button class="modal-close" id="modal-close-btn">&times;</button>
      <div class="modal-header">
        <h3 class="modal-title" id="modal-product-title">Historial de Precios</h3>
        <p class="modal-subtitle">Evolución de precios del producto</p>
      </div>
      <div class="modal-body">
        <!-- Modal Threshold Section -->
        <div class="modal-threshold-section" id="modal-threshold-section">
          <div class="threshold-slider-container">
            <div class="threshold-slider-info">
              <span class="slider-label">Umbral de rebaja para alerta por correo:</span>
              <span class="slider-display-val" id="modal-threshold-slider-val">10%</span>
            </div>
            <div class="threshold-slider-row">
              <span class="pct-limit">1%</span>
              <input type="range" id="modal-threshold-slider" min="1" max="90" value="10" class="threshold-range-slider" />
              <span class="pct-limit">90%</span>
            </div>
          </div>
          <div class="threshold-instructions-row">
            <div class="status-indicator-box">
              <span class="status-indicator-dot" id="modal-threshold-status-dot"></span>
              <span id="modal-threshold-status-text">Alerta inactiva</span>
            </div>
            <p class="json-copy-hint">
              Copiar para <code>products.json</code>:
              <code id="modal-threshold-json-code">"threshold_percentage": 10</code>
            </p>
          </div>
        </div>

        <div class="modal-chart-container" id="modal-chart-container">
          <!-- SVG dinámico se inyectará aquí -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  * {
    box-sizing: border-box;
  }

  body {
    background-color: #0b0c10;
    background-image: 
      radial-gradient(at 0% 0%, rgba(255, 241, 89, 0.05) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(59, 130, 246, 0.03) 0px, transparent 50%);
    color: #f1f5f9;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }

  .page {
    max-width: 1150px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  /* --- Top / Header --- */
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .brand {
    flex: 1;
  }

  .logo-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo-text {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #fff;
    background: linear-gradient(135deg, #fff 40%, #FFF159 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo-badge {
    background: linear-gradient(135deg, #FFF159 0%, #d4c200 100%);
    color: #1a1900;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }

  .tagline {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: #94a3b8;
    font-weight: 400;
  }

  /* --- Stats bar --- */
  .stats-bar {
    display: flex;
    gap: 1rem;
  }

  .stat-card {
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 0.8rem 1.5rem;
    text-align: center;
    min-width: 100px;
    backdrop-filter: blur(10px);
  }

  .stat-card.interactive {
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    font-family: inherit;
  }

  .stat-card.interactive.filter-btn-day .stat-num {
    color: #4ade80;
  }

  .stat-card.interactive.filter-btn-day:hover {
    background: rgba(74, 222, 128, 0.06);
    border-color: rgba(74, 222, 128, 0.25);
    transform: translateY(-2px);
  }

  .stat-card.interactive.filter-btn-day.active {
    background: rgba(74, 222, 128, 0.15);
    border-color: rgba(74, 222, 128, 0.5);
    box-shadow: 0 0 16px rgba(74, 222, 128, 0.25);
  }

  .stat-card.interactive.filter-btn-week .stat-num {
    color: #3b82f6;
  }

  .stat-card.interactive.filter-btn-week:hover {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.25);
    transform: translateY(-2px);
  }

  .stat-card.interactive.filter-btn-week.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.25);
  }

  .stat-card.interactive.filter-btn-month .stat-num {
    color: #ec4899;
  }

  .stat-card.interactive.filter-btn-month:hover {
    background: rgba(236, 72, 153, 0.06);
    border-color: rgba(236, 72, 153, 0.25);
    transform: translateY(-2px);
  }

  .stat-card.interactive.filter-btn-month.active {
    background: rgba(236, 72, 153, 0.15);
    border-color: rgba(236, 72, 153, 0.5);
    box-shadow: 0 0 16px rgba(236, 72, 153, 0.25);
  }

  .page.filter-day .card:not([data-has-discount-day="true"]) {
    display: none !important;
  }

  .page.filter-week .card:not([data-has-discount-week="true"]) {
    display: none !important;
  }

  .page.filter-month .card:not([data-has-discount-month="true"]) {
    display: none !important;
  }

  .stat-num {
    display: block;
    font-size: 1.4rem;
    font-weight: 700;
    color: #FFF159;
    font-family: 'JetBrains Mono', monospace;
  }

  .stat-lbl {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.05em;
    margin-top: 0.2rem;
  }



  /* --- Chart Section --- */
  .chart-section {
    background: rgba(30, 41, 59, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 20px;
    padding: 1.5rem;
    backdrop-filter: blur(10px);
    margin-top: 1rem;
  }

  .chart-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .chart-section h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: #fff;
  }

  .chart-section .subtitle {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
  }

  .legend {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .legend-item .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .chart {
    position: relative;
    border-radius: 12px;
    overflow: visible;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .grid {
    stroke: rgba(255, 255, 255, 0.035);
    stroke-width: 1;
  }

  .label {
    fill: #475569;
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
  }

  .chart-line {
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
    transition: stroke-width 0.15s;
  }

  .point {
    cursor: pointer;
    transition: r 0.1s ease;
  }

  .point:hover {
    r: 7;
  }

  .tooltip {
    position: absolute;
    pointer-events: none;
    background: #FFF159;
    color: #0b0c10;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 241, 89, 0.3);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 100ms ease;
    transform: translate(-50%, -100%);
    margin-top: -12px;
    font-family: 'JetBrains Mono', monospace;
    border: 1px solid #e1d000;
  }

  .tooltip.visible {
    opacity: 1;
  }

  /* --- Alerts / Notices --- */
  .notice {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.2rem;
    background: rgba(239, 68, 68, 0.05);
    border: 1px dashed rgba(239, 68, 68, 0.2);
    border-radius: 12px;
    color: #f87171;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .icon-warning {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .empty-state {
    flex-direction: column;
    text-align: center;
    padding: 3.5rem 2rem;
    background: rgba(30, 41, 59, 0.15);
    border: 1px dashed rgba(255, 255, 255, 0.06);
    color: #64748b;
    gap: 0.5rem;
  }

  .empty-state h3 {
    margin: 0.8rem 0 0;
    color: #cbd5e1;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .empty-state p {
    font-size: 0.85rem;
    margin: 0;
  }

  .empty-state code {
    background: rgba(0, 0, 0, 0.3);
    color: #FFF159;
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .icon-box {
    width: 42px;
    height: 42px;
    color: #3b82f6;
    margin-bottom: 0.5rem;
    opacity: 0.8;
  }

  /* --- Keyframes & Animations --- */
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fade-in 0.4s ease-out forwards;
  }

  .animate-slide-up {
    animation: slide-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  .category-wrapper {
    grid-column: span 1;
  }

  .category-wrapper.span-2 {
    grid-column: span 2;
  }

  @media (max-width: 900px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .category-wrapper, .category-wrapper.span-2 {
      grid-column: span 1;
    }
  }

  @media (max-width: 768px) {
    .top { flex-direction: column; align-items: stretch; margin-bottom: 2rem; }
    .stats-bar { justify-content: space-between; }
    .chart-header-row { flex-direction: column; align-items: flex-start; }
    .legend { margin-top: 0.5rem; }
    .subcategory-wrapper { padding-left: 0; border-left: none; }
  }

  /* --- Modal Styles --- */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
  }

  .modal.active {
    opacity: 1;
    pointer-events: all;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(11, 12, 16, 0.85);
    backdrop-filter: blur(8px);
  }

  .modal-container {
    position: relative;
    background: #1a1b23;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    width: 90%;
    max-width: 620px;
    padding: 2.25rem 2rem 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 30px rgba(255, 241, 89, 0.03);
    transform: scale(0.92);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1001;
  }

  .modal.active .modal-container {
    transform: scale(1);
  }

  .modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s;
  }

  .modal-close:hover {
    color: #fff;
  }

  .modal-header {
    margin-bottom: 1.75rem;
  }

  .modal-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 2rem;
    letter-spacing: -0.01em;
  }

  .modal-subtitle {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0.35rem 0 0;
  }

  .modal-body {
    position: relative;
  }

  .modal-chart-container {
    position: relative;
    background: rgba(15, 23, 42, 0.3);
    border-radius: 16px;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.03);
  }

  .chart-tooltip {
    position: absolute;
    pointer-events: none;
    background: #FFF159;
    color: #0b0c10;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 100ms ease;
    transform: translate(-50%, -100%);
    margin-top: -12px;
    font-family: 'JetBrains Mono', monospace;
    border: 1px solid #e1d000;
    z-index: 1002;
  }

  .chart-tooltip.visible {
    opacity: 1;
  }

  .chart-circle {
    cursor: pointer;
    transition: r 0.15s;
  }

  /* --- Toolbar (Search & Sort) --- */
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(30, 41, 59, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    padding: 0.8rem 1.25rem;
    margin-bottom: 2rem;
    gap: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .search-box {
    display: flex;
    align-items: center;
    background: rgba(15, 23, 42, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 0.5rem 0.85rem;
    flex: 1;
    max-width: 420px;
    gap: 0.6rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .search-box:focus-within {
    border-color: rgba(255, 241, 89, 0.3);
    box-shadow: 0 0 12px rgba(255, 241, 89, 0.06);
  }

  .search-icon {
    width: 16px;
    height: 16px;
    color: #64748b;
    flex-shrink: 0;
  }

  .search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 0.85rem;
    width: 100%;
    font-family: inherit;
  }

  .search-box input::placeholder {
    color: #475569;
  }

  .sort-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sort-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .sort-dropdown {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.45rem 0.85rem;
    border-radius: 10px;
    outline: none;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s;
  }

  .sort-dropdown:hover, .sort-dropdown:focus {
    border-color: rgba(255, 241, 89, 0.2);
  }

  .sort-dropdown option {
    background: #1e293b;
    color: #f1f5f9;
  }

  /* --- Chart Range Selector --- */
  .chart-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .chart-range-selector {
    display: flex;
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 0.2rem;
    gap: 0.1rem;
  }

  .range-btn {
    background: transparent;
    border: none;
    outline: none;
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.8rem;
    border-radius: 7px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .range-btn:hover {
    color: #cbd5e1;
  }

  .range-btn.active {
    background: rgba(255, 241, 89, 0.08);
    color: #FFF159;
    border: 1px solid rgba(255, 241, 89, 0.15);
  }

  /* --- Next Update Banner --- */
  .next-update-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(30, 41, 59, 0.35);
    border: 1px solid rgba(255, 241, 89, 0.12);
    border-radius: 16px;
    padding: 0.85rem 1.5rem;
    margin-bottom: 2rem;
    gap: 1.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.05);
  }

  .banner-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pulse-dot {
    width: 9px;
    height: 9px;
    background-color: #22c55e;
    border-radius: 50%;
    position: relative;
    box-shadow: 0 0 8px #22c55e;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: #22c55e;
    border-radius: 50%;
    animation: dot-pulse 1.8s infinite ease-in-out;
  }

  @keyframes dot-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  .banner-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: #94a3b8;
  }

  .banner-time {
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    font-family: 'JetBrains Mono', monospace;
    background: rgba(255, 241, 89, 0.08);
    color: #FFF159;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 241, 89, 0.15);
  }

  .banner-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .slider-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .slider-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    font-weight: 600;
  }

  .slider-label strong {
    color: #FFF159;
    font-family: 'JetBrains Mono', monospace;
  }

  .slider-control {
    display: flex;
    align-items: center;
  }

  .interval-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 140px;
    height: 5px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.1);
    outline: none;
    cursor: pointer;
    transition: background 0.15s;
  }

  .interval-slider:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Slider Thumb */
  .interval-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #FFF159;
    box-shadow: 0 0 8px rgba(255, 241, 89, 0.5);
    cursor: pointer;
    transition: transform 0.1s, background-color 0.1s;
  }

  .interval-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    background: #fff;
  }

  .interval-slider::-moz-range-thumb {
    width: 13px;
    height: 13px;
    border: none;
    border-radius: 50%;
    background: #FFF159;
    box-shadow: 0 0 8px rgba(255, 241, 89, 0.5);
    cursor: pointer;
    transition: transform 0.1s, background-color 0.1s;
  }

  .interval-slider::-moz-range-thumb:hover {
    transform: scale(1.2);
    background: #fff;
  }

  .cron-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.75rem;
    border-radius: 10px;
    font-size: 0.75rem;
  }

  .cron-label {
    color: #64748b;
    font-weight: 500;
  }

  .cron-box code {
    color: #3b82f6;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .copy-btn {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.15rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, background-color 0.15s;
  }

  .copy-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .copy-btn.copied {
    color: #22c55e;
  }

  /* Responsive styles adjustment */
  @media (max-width: 768px) {
    .next-update-banner {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem;
    }
    .banner-right {
      justify-content: space-between;
      gap: 1rem;
    }
    .interval-slider {
      width: 100%;
    }
    .slider-wrapper {
      flex: 1;
    }
  }

  /* --- Card Cursor Pointer --- */
  .card {
    cursor: pointer;
  }

  /* --- Modal Threshold Section --- */
  .modal-threshold-section {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid rgba(251, 191, 36, 0.15);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .threshold-slider-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .threshold-slider-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-label {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .slider-display-val {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fbbf24;
    font-family: 'JetBrains Mono', monospace;
    background: rgba(251, 191, 36, 0.08);
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    border: 1px solid rgba(251, 191, 36, 0.15);
  }

  .threshold-slider-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pct-limit {
    font-size: 0.7rem;
    color: #475569;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
  }

  .threshold-range-slider {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 5px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.08);
    outline: none;
    cursor: pointer;
  }

  .threshold-range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fbbf24;
    box-shadow: 0 0 8px rgba(251, 191, 36, 0.4);
    cursor: pointer;
  }

  .threshold-range-slider::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: none;
    border-radius: 50%;
    background: #fbbf24;
    box-shadow: 0 0 8px rgba(251, 191, 36, 0.4);
    cursor: pointer;
  }

  .threshold-instructions-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 0.6rem;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .status-indicator-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .status-indicator-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .status-indicator-dot.active {
    background-color: #fbbf24;
    box-shadow: 0 0 6px #fbbf24;
    animation: alert-pulse 2s infinite ease-in-out;
  }

  @keyframes alert-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }

  .status-indicator-dot.inactive {
    background-color: #475569;
  }

  .json-copy-hint {
    margin: 0;
    font-size: 0.72rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .json-copy-hint code {
    background: rgba(15, 23, 42, 0.6);
    color: #3b82f6;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.03);
  }
</style>

<script>
  let selectedProductCard: HTMLElement | null = null;

  const container = document.getElementById("chart-container")
  const tooltip = document.getElementById("chart-tooltip")
  if (container && tooltip) {
    const svg = container.querySelector("svg")!
    const points = container.querySelectorAll<SVGCircleElement>(".point")

    points.forEach((point) => {
      point.addEventListener("mouseenter", () => {
        const price = point.dataset.price
        const date = point.dataset.date
        const name = point.dataset.name
        const color = point.dataset.color || "#FFF159"
        
        tooltip.innerHTML = `<span style="font-size:0.65rem; opacity:0.8; display:block; font-weight:500; color:#3f3f46; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px">${name}</span><strong>${price}</strong> <span style="font-weight:500; font-size:0.65rem; color:#4b5563">(${date})</span>`
        tooltip.style.borderColor = color
        tooltip.classList.add("visible")

        const svgRect = svg.getBoundingClientRect()
        const viewBox = svg.viewBox.baseVal
        const cx = parseFloat(point.getAttribute("cx")!)
        const cy = parseFloat(point.getAttribute("cy")!)

        const px = (cx / viewBox.width) * svgRect.width
        const py = (cy / viewBox.height) * svgRect.height

        tooltip.style.left = `${px}px`
        tooltip.style.top = `${py}px`
      })

      point.addEventListener("mouseleave", () => {
        tooltip.classList.remove("visible")
      })
    })
  }

  // Price drops toggle filters
  const btnDay = document.getElementById("filter-btn-day")
  const btnWeek = document.getElementById("filter-btn-week")
  const btnMonth = document.getElementById("filter-btn-month")
  const pageElement = document.querySelector(".page")

  if (pageElement) {
    const filterButtons = [
      { btn: btnDay, class: "filter-day", attr: "data-has-discount-day" },
      { btn: btnWeek, class: "filter-week", attr: "data-has-discount-week" },
      { btn: btnMonth, class: "filter-month", attr: "data-has-discount-month" }
    ]

    filterButtons.forEach((item) => {
      if (!item.btn) return
      item.btn.addEventListener("click", () => {
        const isCurrentlyActive = item.btn.classList.contains("active")

        // Deactivate all first
        filterButtons.forEach((other) => {
          other.btn?.classList.remove("active")
          pageElement.classList.remove(other.class)
        })

        if (!isCurrentlyActive) {
          // Activate this one
          item.btn.classList.add("active")
          pageElement.classList.add(item.class)

          // Filter category nodes
          const categories = document.querySelectorAll(".category-node")
          categories.forEach((cat) => {
            if (cat instanceof HTMLElement) {
              const hasDiscountCard = cat.querySelector(`.card[${item.attr}="true"]`) !== null
              if (hasDiscountCard) {
                cat.style.display = ""
              } else {
                cat.style.display = "none"
              }
            }
          })
        } else {
          // Reset all category nodes display
          const categories = document.querySelectorAll(".category-node")
          categories.forEach((cat) => {
            if (cat instanceof HTMLElement) {
              cat.style.display = ""
            }
          })
        }
      })
    })
  }

  // Helper to render modal chart
  function renderModalChart(historyPoints: any[], color: string, currency: string) {
    const container = document.getElementById("modal-chart-container")
    if (!container) return

    if (!historyPoints || historyPoints.length === 0) {
      container.innerHTML = "<p style='color:#64748b;font-size:0.85rem;text-align:center;padding:2rem;'>No hay datos históricos disponibles.</p>"
      return
    }

    const W = 540
    const H = 240
    const PL = 64
    const PR = 16
    const PT = 16
    const PB = 36
    const PW = W - PL - PR
    const PH = H - PT - PB

    const points = historyPoints.map(pt => ({
      price: pt.price,
      time: new Date(pt.scrapedAt).getTime(),
      rawDate: pt.scrapedAt
    })).sort((a, b) => a.time - b.time)

    const prices = points.map(pt => pt.price)
    const times = points.map(pt => pt.time)

    const minPrice = Math.min(...prices)
    const maxPrice = Math.max(...prices)
    const minTime = Math.min(...times)
    const maxTime = Math.max(...times)

    const margin = (maxPrice - minPrice) * 0.1 || 10
    const yMin = minPrice - margin
    const yMax = maxPrice + margin

    const getX = (t: number) => maxTime === minTime ? PL + PW / 2 : PL + ((t - minTime) / (maxTime - minTime)) * PW
    const getY = (p: number) => yMax === yMin ? PT + PH / 2 : PT + ((yMax - p) / (yMax - yMin)) * PH

    let pathD = ""
    points.forEach((pt, idx) => {
      const px = getX(pt.time).toFixed(1)
      const py = getY(pt.price).toFixed(1)
      pathD += `${idx === 0 ? "M" : "L"}${px} ${py}`
    })

    const fmtVal = (v: number) => {
      const formatted = v.toLocaleString("es-AR", { maximumFractionDigits: 0 })
      const symbol = currency === "ARS" || currency === "$" ? "$" : (currency || "$")
      return `${symbol} ${formatted}`
    }

    const yTicks = Array.from({ length: 4 }, (_, i) => yMax - (i / 3) * (yMax - yMin))
    const yTicksHTML = yTicks.map(v => `
      <g>
        <line x1="${PL}" y1="${getY(v)}" x2="${W - PR}" y2="${getY(v)}" stroke="rgba(255,255,255,0.035)" stroke-width="1" />
        <text x="${PL - 10}" y="${getY(v) + 4}" fill="#475569" font-size="10" font-family="JetBrains Mono, monospace" text-anchor="end">${fmtVal(v)}</text>
      </g>
    `).join("")

    const uniqueDates = [...new Set(points.map(pt => pt.rawDate.slice(0, 10)))]
    const xTickCount = Math.min(4, uniqueDates.length)
    const xStep = points.length > 1 ? (maxTime - minTime) / Math.max(xTickCount - 1, 1) : 0
    let xTicksHTML = ""
    for (let i = 0; i < xTickCount; i++) {
      const t = minTime + i * xStep
      const label = new Date(t).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short" })
      xTicksHTML += `
        <text x="${getX(t)}" y="${H - 8}" fill="#475569" font-size="10" font-family="JetBrains Mono, monospace" text-anchor="middle">${label}</text>
      `
    }

    const circlesHTML = points.map(pt => {
      const cx = getX(pt.time)
      const cy = getY(pt.price)
      const dateStr = new Date(pt.rawDate).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short", hour: "2-digit" }) + "hs"
      return `
        <circle
          cx="${cx}"
          cy="${cy}"
          r="4.5"
          fill="${color}"
          class="chart-circle"
          data-price="${fmtVal(pt.price)}"
          data-date="${dateStr}"
        />
      `
    }).join("")

    container.innerHTML = `
      <svg viewBox="0 0 ${W} ${H}" width="100%" height="auto" style="overflow: visible; display: block;">
        ${yTicksHTML}
        ${xTicksHTML}
        <path d="${pathD}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
        ${circlesHTML}
      </svg>
      <div class="chart-tooltip" id="modal-chart-tooltip"></div>
    `

    const circles = container.querySelectorAll(".chart-circle")
    const tooltip = container.querySelector("#modal-chart-tooltip") as HTMLElement
    const svg = container.querySelector("svg")

    if (tooltip && svg) {
      circles.forEach(circle => {
        circle.addEventListener("mouseenter", () => {
          const price = circle.getAttribute("data-price")
          const date = circle.getAttribute("data-date")
          tooltip.innerHTML = `<strong>${price}</strong> <span style="font-size:0.65rem; opacity:0.8; margin-left:4px;">(${date})</span>`
          tooltip.classList.add("visible")

          const svgRect = svg.getBoundingClientRect()
          const cx = parseFloat(circle.getAttribute("cx") || "0")
          const cy = parseFloat(circle.getAttribute("cy") || "0")

          const px = (cx / W) * svgRect.width
          const py = (cy / H) * svgRect.height

          tooltip.style.left = `${px}px`
          tooltip.style.top = `${py}px`
        })

        circle.addEventListener("mouseleave", () => {
          tooltip.classList.remove("visible")
        })
      })
    }
  }

  // Modal toggle and event handlers
  const modal = document.getElementById("price-history-modal")
  const modalOverlay = modal?.querySelector(".modal-overlay")
  const modalCloseBtn = document.getElementById("modal-close-btn")
  const modalProductTitle = document.getElementById("modal-product-title")

  if (modal && modalOverlay && modalCloseBtn && modalProductTitle) {
    const closeModal = () => {
      modal.classList.remove("active")
      selectedProductCard = null;
    }

    modalOverlay.addEventListener("click", closeModal)
    modalCloseBtn.addEventListener("click", closeModal)

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeModal()
      }
    })

    document.addEventListener("click", (e) => {
      const target = e.target
      if (target && typeof (target as any).closest === "function") {
        const rangeBox = (target as any).closest(".range-box")
        if (rangeBox && rangeBox instanceof HTMLElement) {
          const historyData = rangeBox.dataset.history
          if (historyData) {
            try {
              const historyPoints = JSON.parse(historyData)
              const title = rangeBox.dataset.title || "Producto"
              const color = rangeBox.dataset.color || "#FFF159"
              const currency = rangeBox.dataset.currency || "ARS"

              modalProductTitle.textContent = title
              modal.classList.add("active")

              const card = rangeBox.closest(".card")
              if (card && card instanceof HTMLElement) {
                selectedProductCard = card;
                updateModalThresholdUI(card);
              }

              renderModalChart(historyPoints, color, currency)
            } catch (err) {
              console.error("Error parsing history data", err)
            }
          }
        }
      }
    })
  }

  // Real-time Search Filter
  const searchInput = document.getElementById("search-input")
  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      const query = (e.target as any).value.trim().toLowerCase()
      const cards = document.querySelectorAll(".card")

      // Find current active discount filter
      const activeFilter = document.querySelector(".stat-card.interactive.active")
      const filterAttr = activeFilter ? (activeFilter.id === "filter-btn-day" ? "data-has-discount-day" : activeFilter.id === "filter-btn-week" ? "data-has-discount-week" : "data-has-discount-month") : null

      cards.forEach((card) => {
        if (card instanceof HTMLElement) {
          const name = card.dataset.name || ""
          const asin = card.dataset.asin || ""
          const matchesQuery = name.includes(query) || asin.includes(query)

          let matchesFilter = true
          if (filterAttr) {
            matchesFilter = card.getAttribute(filterAttr) === "true"
          }

          if (matchesQuery && matchesFilter) {
            card.style.display = ""
          } else {
            card.style.display = "none"
          }
        }
      })

      // Hide empty categories
      const categories = document.querySelectorAll(".category-node")
      categories.forEach((cat) => {
        if (cat instanceof HTMLElement) {
          const hasVisibleCards = Array.from(cat.querySelectorAll(".card")).some(c => (c as HTMLElement).style.display !== "none")
          if (hasVisibleCards) {
            cat.style.display = ""
          } else {
            cat.style.display = "none"
          }
        }
      })
    })
  }

  // Real-time Sort Option
  const sortSelect = document.getElementById("sort-select")
  if (sortSelect) {
    sortSelect.addEventListener("change", () => {
      const value = (sortSelect as HTMLSelectElement).value
      const cardsContainers = document.querySelectorAll(".cards")

      cardsContainers.forEach((container) => {
        const cards = Array.from(container.children) as HTMLElement[]
        
        cards.sort((a, b) => {
          if (value === "price-asc") {
            const pa = parseFloat(a.dataset.price || "0")
            const pb = parseFloat(b.dataset.price || "0")
            return pa - pb
          } else if (value === "price-desc") {
            const pa = parseFloat(a.dataset.price || "0")
            const pb = parseFloat(b.dataset.price || "0")
            return pb - pa
          } else if (value === "discount-desc") {
            const da = parseFloat(a.dataset.discount || "0")
            const db = parseFloat(b.dataset.discount || "0")
            return db - da
          } else if (value === "date-desc") {
            const t1 = parseInt(a.dataset.date || "0", 10)
            const t2 = parseInt(b.dataset.date || "0", 10)
            return t2 - t1
          } else {
            const idxA = parseInt(a.dataset.index || "0", 10)
            const idxB = parseInt(b.dataset.index || "0", 10)
            return idxA - idxB
          }
        })

        cards.forEach((card) => {
          container.appendChild(card)
        })
      })
    })
  }

  // Main Chart Range Selector & Rendering
  const chartContainer = document.getElementById("chart-container")
  const rangeButtons = document.querySelectorAll(".range-btn")

  if (chartContainer && rangeButtons.length > 0) {
    const rawSeries = chartContainer.dataset.series
    if (rawSeries) {
      try {
        const fullSeries = JSON.parse(rawSeries)

        const updateMainChart = (rangeValue: string) => {
          const W = 900
          const H = 340
          const PL = 72
          const PR = 20
          const PT = 20
          const PB = 44
          const PW = W - PL - PR
          const PH = H - PT - PB

          let filteredSeries = fullSeries.map((s: any) => {
            let pts = s.historyPoints || []
            if (rangeValue !== "all") {
              const days = parseInt(rangeValue, 10)
              const cutoffTime = Date.now() - days * 24 * 60 * 60 * 1000
              pts = pts.filter((pt: any) => new Date(pt.scrapedAt).getTime() >= cutoffTime)
            }
            return { ...s, pts }
          }).filter((s: any) => s.pts.length > 0)

          const allPrices = filteredSeries.flatMap((s: any) => s.pts.map((pt: any) => pt.price))
          const allDates = filteredSeries.flatMap((s: any) => s.pts.map((pt: any) => new Date(pt.scrapedAt).getTime()))

          if (allPrices.length === 0 || allDates.length === 0) {
            chartContainer.innerHTML = "<p style='color:#64748b;font-size:0.85rem;text-align:center;padding:4rem;'>No hay datos disponibles para este período.</p>"
            return
          }

          const minPrice = Math.min(...allPrices)
          const maxPrice = Math.max(...allPrices)
          const minDate = Math.min(...allDates)
          const maxDate = Math.max(...allDates)

          const margin = (maxPrice - minPrice) * 0.1 || 1
          const yMin = minPrice - margin
          const yMax = maxPrice + margin

          const getX = (ts: number) => maxDate === minDate ? PL + PW / 2 : PL + ((ts - minDate) / (maxDate - minDate)) * PW
          const getY = (p: number) => yMax === yMin ? PT + PH / 2 : PT + ((yMax - p) / (yMax - yMin)) * PH

          const fmtVal = (price: number, currency: string) => {
            const formatted = price.toLocaleString("es-AR", { maximumFractionDigits: 0 })
            const symbol = currency === "ARS" || currency === "$" ? "$" : (currency || "$")
            return `${symbol} ${formatted}`
          }

          const yTicks = Array.from({ length: 5 }, (_, i) => yMax - (i / 4) * (yMax - yMin))
          const yTicksHTML = yTicks.map(v => `
            <g>
              <line x1="${PL}" y1="${getY(v)}" x2="${W - PR}" y2="${getY(v)}" class="grid" stroke="rgba(255,255,255,0.035)" stroke-width="1" />
              <text x="${PL - 10}" y="${getY(v) + 4}" class="label" text-anchor="end" fill="#475569" font-size="10" font-family="JetBrains Mono, monospace">${fmtVal(v, filteredSeries[0]?.currency || "ARS")}</text>
            </g>
          `).join("")

          const uniqueDays = [...new Set(filteredSeries.flatMap((s: any) => s.pts.map((pt: any) => pt.scrapedAt.slice(0, 10))))]
          const xTickCount = Math.min(6, uniqueDays.length)
          const xStep = allDates.length > 1 ? (maxDate - minDate) / Math.max(xTickCount - 1, 1) : 0
          let xTicksHTML = ""
          for (let i = 0; i < xTickCount; i++) {
            const ts = minDate + i * xStep
            const label = new Date(ts).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short" })
            xTicksHTML += `
              <text x="${getX(ts)}" y="${H - PB + 22}" class="label" text-anchor="middle" fill="#475569" font-size="10" font-family="JetBrains Mono, monospace">${label}</text>
            `
          }

          const pathsHTML = filteredSeries.map((s: any) => {
            const d = s.pts.map((pt: any, idx: number) => `${idx === 0 ? "M" : "L"}${getX(new Date(pt.scrapedAt).getTime()).toFixed(1)} ${getY(pt.price).toFixed(1)}`).join(" ")
            return `
              <path d="${d}" fill="none" stroke="${s.color}" stroke-width="2.5" stroke-linejoin="round" class="chart-line" />
            `
          }).join("")

          const circlesHTML = filteredSeries.flatMap((s: any) => {
            return s.pts.map((pt: any) => {
              const cx = getX(new Date(pt.scrapedAt).getTime())
              const cy = getY(pt.price)
              const dateStr = new Date(pt.scrapedAt).toLocaleDateString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", day: "2-digit", month: "short", hour: "2-digit" }) + "hs"
              return `
                <circle
                  cx="${cx}"
                  cy="${cy}"
                  r="4.5"
                  fill="${s.color}"
                  class="point"
                  data-price="${fmtVal(pt.price, s.currency || "ARS")}"
                  data-date="${dateStr}"
                  data-name="${s.customName || s.title || s.asin}"
                  data-color="${s.color}"
                />
              `
            })
          }).join("")

          chartContainer.innerHTML = `
            <svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Historial de precios de MercadoLibre" style="width:100%; height:auto; display:block;">
              ${yTicksHTML}
              ${xTicksHTML}
              ${pathsHTML}
              ${circlesHTML}
            </svg>
            <div class="tooltip" id="chart-tooltip"></div>
          `

          const svg = chartContainer.querySelector("svg")!
          const tooltip = chartContainer.querySelector("#chart-tooltip") as HTMLElement
          const points = chartContainer.querySelectorAll(".point")

          if (tooltip && svg) {
            points.forEach((point) => {
              point.addEventListener("mouseenter", () => {
                const price = point.getAttribute("data-price")
                const date = point.getAttribute("data-date")
                const name = point.getAttribute("data-name")
                const color = point.getAttribute("data-color") || "#FFF159"

                tooltip.innerHTML = `<span style="font-size:0.65rem; opacity:0.8; display:block; font-weight:500; color:#3f3f46; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px">${name}</span><strong>${price}</strong> <span style="font-weight:500; font-size:0.65rem; color:#4b5563">(${date})</span>`
                tooltip.style.borderColor = color
                tooltip.classList.add("visible")

                const svgRect = svg.getBoundingClientRect()
                const cx = parseFloat(point.getAttribute("cx") || "0")
                const cy = parseFloat(point.getAttribute("cy") || "0")

                const px = (cx / W) * svgRect.width
                const py = (cy / H) * svgRect.height

                tooltip.style.left = `${px}px`
                tooltip.style.top = `${py}px`
              })

              point.addEventListener("mouseleave", () => {
                tooltip.classList.remove("visible")
              })
            })
          }
        }

        rangeButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            rangeButtons.forEach(b => b.classList.remove("active"))
            btn.classList.add("active")
            const range = btn.getAttribute("data-range") || "all"
            updateMainChart(range)
          })
        })

      } catch (err) {
        console.error("Error parsing main chart series data", err)
      }
    }
  }

  // Next Update Banner Logic
  const banner = document.querySelector(".next-update-banner");
  if (banner) {
    const nextUpdateTimeEl = document.getElementById("next-update-time");
    const intervalSlider = document.getElementById("update-interval-slider");
    const sliderValueEl = document.getElementById("slider-value");
    const cronCodeEl = document.getElementById("cron-code");
    const copyCronBtn = document.getElementById("copy-cron-btn");

    if (nextUpdateTimeEl && intervalSlider && sliderValueEl && cronCodeEl && copyCronBtn) {
      // Load saved interval, default to 7 hours
      let intervalHours = parseInt(localStorage.getItem("update-interval") || "7", 10);
      if (isNaN(intervalHours) || intervalHours < 1 || intervalHours > 24) {
        intervalHours = 7;
      }
      
      (intervalSlider as HTMLInputElement).value = intervalHours.toString();
      updateBannerUI(intervalHours);

      // Listen for slider inputs
      intervalSlider.addEventListener("input", (e) => {
        const val = parseInt((e.target as HTMLInputElement).value, 10);
        localStorage.setItem("update-interval", val.toString());
        updateBannerUI(val);
      });

      // Periodically update the remaining time (every minute)
      setInterval(() => {
        const val = parseInt((intervalSlider as HTMLInputElement).value, 10);
        updateBannerUI(val);
      }, 60000);

      // Copy to Clipboard logic
      copyCronBtn.addEventListener("click", () => {
        const cronText = cronCodeEl.textContent || "0 */7 * * *";
        navigator.clipboard.writeText(cronText).then(() => {
          copyCronBtn.classList.add("copied");
          const origSVG = copyCronBtn.innerHTML;
          // Change to check icon
          copyCronBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>`;
          
          setTimeout(() => {
            copyCronBtn.classList.remove("copied");
            copyCronBtn.innerHTML = origSVG;
          }, 2000);
        }).catch(err => {
          console.error("No se pudo copiar el texto: ", err);
        });
      });
    }

    function getNextCronTime(intervalHours: number): Date {
      const now = new Date();
      // Start with the current hour truncated to 0 minutes, 0 seconds
      const next = new Date(Date.UTC(
        now.getUTCFullYear(),
        now.getUTCMonth(),
        now.getUTCDate(),
        now.getUTCHours(),
        0, 0, 0
      ));
      
      // If we are already past the 0th minute of this hour, check future hours
      if (now.getTime() >= next.getTime()) {
        next.setUTCHours(next.getUTCHours() + 1);
      }
      
      // Find the next UTC hour that is divisible by intervalHours
      while (next.getUTCHours() % intervalHours !== 0) {
        next.setUTCHours(next.getUTCHours() + 1);
      }
      
      return next;
    }

    function updateBannerUI(hours: number) {
      if (!sliderValueEl || !cronCodeEl || !nextUpdateTimeEl) return;

      // Update Slider text label
      sliderValueEl.textContent = hours === 1 ? "1 hora" : `${hours} horas`;

      // Update Cron display code
      let cronStr = `0 */${hours} * * *`;
      if (hours === 1) {
        cronStr = "0 * * * *";
      }
      cronCodeEl.textContent = cronStr;

      // Calculate next update time
      const nextRun = getNextCronTime(hours);
      
      // Format time in Argentina (America/Argentina/Buenos_Aires)
      const timeFormatter = new Intl.DateTimeFormat("es-AR", {
        timeZone: "America/Argentina/Buenos_Aires",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
      });
      const timeStr = timeFormatter.format(nextRun);

      const dateFormatter = new Intl.DateTimeFormat("es-AR", {
        timeZone: "America/Argentina/Buenos_Aires",
        day: "2-digit",
        month: "2-digit"
      });
      
      const nextRunDateStr = dateFormatter.format(nextRun);
      const todayDateStr = dateFormatter.format(new Date());
      
      const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);
      const tomorrowDateStr = dateFormatter.format(tomorrow);

      let dayLabel = "";
      if (nextRunDateStr === todayDateStr) {
        dayLabel = "Hoy";
      } else if (nextRunDateStr === tomorrowDateStr) {
        dayLabel = "Mañana";
      } else {
        // Show as DD/MM
        dayLabel = nextRunDateStr;
      }

      // Calculate relative time
      const msRemaining = nextRun.getTime() - Date.now();
      let relativeStr = "";
      if (msRemaining <= 0) {
        relativeStr = "en cualquier momento";
      } else {
        const totalMinutes = Math.ceil(msRemaining / (60 * 1000));
        const remHours = Math.floor(totalMinutes / 60);
        const remMinutes = totalMinutes % 60;
        if (remHours > 0) {
          relativeStr = `en ${remHours}h ${remMinutes}m`;
        } else {
          relativeStr = `en ${remMinutes}m`;
        }
      }

      nextUpdateTimeEl.innerHTML = `${dayLabel}, ${timeStr} hs <span style="font-size:0.75rem; font-weight:500; opacity:0.85; margin-left: 2px;">(${relativeStr})</span>`;
    }
  }

  // Threshold Configuration Slider inside Modal Logic
  // 1. Helper to update a card's alert badge
  function updateCardAlertBadge(card: HTMLElement) {
    const discount = parseFloat(card.dataset.discount || "0");
    const threshold = parseFloat(card.dataset.threshold || "10");
    const badge = card.querySelector(".badge-alert-active") as HTMLElement;
    if (badge) {
      const isFiresale = discount >= threshold;
      if (isFiresale) {
        badge.style.display = "";
        badge.setAttribute("title", `¡Alerta activada! El descuento de ${discount.toFixed(1)}% superó el umbral de ${threshold.toFixed(0)}%`);
      } else {
        badge.style.display = "none";
      }
    }
  }

  // 2. Load custom saved thresholds from localStorage on page load
  function applySavedThresholds() {
    const cards = document.querySelectorAll(".card");
    cards.forEach((card) => {
      if (card instanceof HTMLElement) {
        const asin = card.dataset.asin;
        if (asin) {
          const savedVal = localStorage.getItem(`threshold-${asin}`);
          if (savedVal) {
            card.dataset.threshold = savedVal;
          }
          updateCardAlertBadge(card);
        }
      }
    });
  }

  // Apply initially
  applySavedThresholds();

  // 3. Helper to update the details in the Modal Threshold settings panel
  function updateModalThresholdUI(card: HTMLElement) {
    const slider = document.getElementById("modal-threshold-slider") as HTMLInputElement;
    const valDisplay = document.getElementById("modal-threshold-slider-val");
    const statusDot = document.getElementById("modal-threshold-status-dot");
    const statusText = document.getElementById("modal-threshold-status-text");
    const jsonCode = document.getElementById("modal-threshold-json-code");

    if (!slider || !valDisplay || !statusDot || !statusText || !jsonCode) return;

    const discount = parseFloat(card.dataset.discount || "0");
    const threshold = parseFloat(card.dataset.threshold || "10");

    slider.value = threshold.toString();
    valDisplay.textContent = `${threshold}%`;

    const isFiresale = discount >= threshold;
    if (isFiresale) {
      statusDot.className = "status-indicator-dot active";
      statusText.textContent = "Alerta activa (descuento supera el umbral)";
      statusText.style.color = "#fbbf24";
    } else {
      statusDot.className = "status-indicator-dot inactive";
      statusText.textContent = `Alerta inactiva (descuento actual del ${discount.toFixed(1)}% es menor al umbral)`;
      statusText.style.color = "#64748b";
    }

    jsonCode.textContent = `"threshold_percentage": ${threshold}`;
  }

  // 4. Handle modal threshold slider change events
  const modalThresholdSlider = document.getElementById("modal-threshold-slider") as HTMLInputElement;
  if (modalThresholdSlider) {
    modalThresholdSlider.addEventListener("input", (e) => {
      if (!selectedProductCard) return;

      const val = parseInt((e.target as HTMLInputElement).value, 10);
      selectedProductCard.dataset.threshold = val.toString();
      
      const asin = selectedProductCard.dataset.asin;
      if (asin) {
        localStorage.setItem(`threshold-${asin}`, val.toString());
      }

      // Update badge on card in the background dashboard
      updateCardAlertBadge(selectedProductCard);

      // Update Modal Threshold UI
      updateModalThresholdUI(selectedProductCard);
    });
  }
</script>
